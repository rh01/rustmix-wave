# Rust main task: leave margin for rendering and log formatting.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# Waveshare ESP32-S3-WROOM-1-N16R8 module: 16 MB flash, octal PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Allocations larger than 16 KiB (chapter shards, decoded text) go to PSRAM.
# Smaller TLS and Wi-Fi buffers stay in internal RAM.
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# The long-lived WeRead worker asks pthread for a PSRAM stack. Tasks that
# touch flash or NVS keep internal stacks; that worker does neither.
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# Embed a semantic product milestone version in the ESP-IDF app descriptor.
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="1.0.0"

# Wi-Fi/SNTP milestone defaults.
CONFIG_LWIP_SNTP_MAX_SERVERS=1
CONFIG_LWIP_SNTP_UPDATE_DELAY=3600000

# HTTPS weather retrieval uses the ESP-IDF certificate bundle.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_DEFAULT_CERTIFICATE_BUNDLE=y

# Embedded browser requests commonly exceed the ESP-IDF 512-byte default.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Dynamic frequency scaling 80-240 MHz and tickless automatic light sleep.
# 80 MHz is the floor that keeps octal PSRAM valid. Bluetooth stays off in
# this Wi-Fi firmware; the modem is only started for a station or SoftAP job.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160 is not set
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y
CONFIG_PM_DFS_MIN_FREQ_MHZ=80
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP=y
CONFIG_PM_SLP_IRAM_OPT=y
CONFIG_PM_RTOS_IDLE_OPT=y
CONFIG_FREERTOS_HZ=100
CONFIG_ESP_WIFI_SLP_IRAM_OPT=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y
# CONFIG_BT_ENABLED is not set
