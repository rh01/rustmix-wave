# Rust main task: leave margin for rendering and log formatting.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# Waveshare ESP32-S3-WROOM-1-N16R8 module: 16 MB flash, octal PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Allocations larger than 16 KiB (an opened chapter shard, decoded text, SD
# TTF outlines) go to PSRAM. Offline download writes 8 KiB chunks and does not
# keep the shard resident. A ~2 MiB face parsed by fontdue occupies more than
# 2 MiB there. The 2 KiB TLS I/O buffers stay in internal RAM.
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# The long-lived WeRead worker asks pthread for a PSRAM stack. Tasks that
# touch flash, NVS, or the SD card keep internal stacks. This worker does
# none of those; the main task writes each download chunk.
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# Embed a semantic product milestone version in the ESP-IDF app descriptor.
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="1.0.0"

# Wi-Fi/SNTP milestone defaults.
CONFIG_LWIP_SNTP_MAX_SERVERS=1
CONFIG_LWIP_SNTP_UPDATE_DELAY=3600000

# HTTPS uses the ESP-IDF certificate bundle. The full bundle is already the
# Kconfig default (CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL).
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# Embedded browser requests commonly exceed the ESP-IDF 512-byte default.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Dynamic frequency scaling and tickless automatic light sleep.
# The 80 MHz floor that keeps octal PSRAM valid is set at runtime in
# power_policy via esp_pm_configure. Bluetooth stays off in this Wi-Fi
# firmware; the modem is only started for a station or SoftAP job.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160 is not set
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP=y
CONFIG_PM_SLP_IRAM_OPT=y
CONFIG_PM_RTOS_IDLE_OPT=y
CONFIG_FREERTOS_HZ=100
CONFIG_ESP_WIFI_SLP_IRAM_OPT=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y
# CONFIG_BT_ENABLED is not set
